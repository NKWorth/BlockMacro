<Window x:Class="MacroBlocks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MacroBlocks.ViewModels"
        xmlns:models="clr-namespace:MacroBlocks.Models"
        xmlns:ui="clr-namespace:MacroBlocks.Ui"
        xmlns:conv="clr-namespace:MacroBlocks.Ui.Converters"
        xmlns:local="clr-namespace:MacroBlocks"
        mc:Ignorable="d"
        Title="MacroBlocks"
        Height="720"
        Width="1100"
        MinHeight="520"
        MinWidth="900"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <DataTemplate x:Key="DefaultBlockTemplate">
            <Border Tag="BlockChrome"
                    Margin="0,0,0,6"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Cursor="SizeAll"
                    PreviewMouseLeftButtonDown="BlockItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="BlockItem_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="BlockItem_PreviewMouseLeftButtonUp">
                <Border.Background>
                    <MultiBinding Converter="{x:Static conv:SelectedBlockBackgroundConverter.Instance}">
                        <Binding />
                        <Binding Path="DataContext.SelectedBlock"
                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="{Binding Summary}"
                               Foreground="#6B7280"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ContinueUntilBlockTemplate">
            <Border Tag="FlowChrome"
                    Margin="0,0,0,8"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#EFF6FF"
                    PreviewMouseLeftButtonDown="BlockItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="BlockItem_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="BlockItem_PreviewMouseLeftButtonUp">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="10,8,10,4"
                            Cursor="SizeAll"
                            Background="Transparent"
                            AllowDrop="True"
                            DragOver="FlowHeader_DragOver"
                            Drop="FlowHeader_Drop">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A" />
                            <TextBlock Text="{Binding Summary}"
                                       Foreground="#3B82F6"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Event slot: accepts only Event blocks -->
                    <Border DockPanel.Dock="Top"
                            Tag="EventSlot"
                            Margin="14,2,8,6"
                            Padding="6"
                            MinHeight="44"
                            Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            BorderThickness="1"
                            CornerRadius="4"
                            AllowDrop="True"
                            DragOver="FlowEventSlot_DragOver"
                            Drop="FlowEventSlot_Drop">
                        <Grid>
                            <TextBlock Text="Drop event here"
                                       Foreground="#D97706"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding EventSlot, Converter={x:Static conv:NullToVisibilityConverter.WhenNull}}" />

                            <Border Visibility="{Binding EventSlot, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <Border BorderBrush="#F59E0B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Cursor="SizeAll"
                                        DataContext="{Binding EventSlot}"
                                        PreviewMouseLeftButtonDown="BlockItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="BlockItem_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="BlockItem_PreviewMouseLeftButtonUp">
                                    <Border.Background>
                                        <MultiBinding Converter="{x:Static conv:SelectedBlockBackgroundConverter.Instance}">
                                            <Binding />
                                            <Binding Path="DataContext.SelectedBlock"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#92400E"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="#B45309"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Tag="FlowBody"
                            Margin="14,0,8,8"
                            Padding="8"
                            MinHeight="48"
                            Background="#F8FAFC"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="4"
                            AllowDrop="True"
                            DragOver="FlowBody_DragOver"
                            Drop="FlowBody_Drop">
                        <Grid>
                            <TextBlock Text="Drop blocks here"
                                       Foreground="#93C5FD"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Children}"
                                          ItemTemplateSelector="{DynamicResource BlockTemplateSelector}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ui:BlockTemplateSelector x:Key="BlockTemplateSelector"
                                     DefaultTemplate="{StaticResource DefaultBlockTemplate}"
                                     ContinueUntilTemplate="{StaticResource ContinueUntilBlockTemplate}" />
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MacroBlocks"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center" />
                <TextBlock Text="Blocks · Subscripts · Events"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="13" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <CheckBox Content="Loop forever"
                          IsChecked="{Binding LoopForever}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          IsEnabled="{Binding IsRunning, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                <Button Content="Run"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}"
                        Width="88"
                        Margin="0,0,8,0" />
                <Button Content="Stop"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding StopCommand}"
                        Width="88" />
            </StackPanel>
        </DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#E5E7EB"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}"
                       Foreground="#374151"
                       FontSize="12" />
        </Border>

        <!-- Body -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Block palette -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Blocks"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   LineHeight="15"
                                   Margin="0,0,0,10"
                                   Text="Click to configure, then Insert or drag into the script." />

                        <TextBlock Text="Actions"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,6" />
                        <Button Content="Delay"
                                Style="{StaticResource ToolButton}"
                                Tag="Delay"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Mouse Move"
                                Style="{StaticResource ToolButton}"
                                Tag="MouseMove"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Mouse Click"
                                Style="{StaticResource ToolButton}"
                                Tag="MouseClick"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Key Press"
                                Style="{StaticResource ToolButton}"
                                Tag="KeyPress"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Return Boolean"
                                Style="{StaticResource ToolButton}"
                                Tag="ReturnBoolean"
                                ToolTip="Sets this script's Boolean output for Flow Graph If nodes"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Find Image"
                                Style="{StaticResource ToolButton}"
                                Tag="FindImage"
                                ToolTip="Search the screen or a window for a template image; sets Boolean output"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />

                        <TextBlock Text="Flow"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,8,0,6" />
                        <Button Content="Continue Until"
                                Style="{StaticResource ToolButton}"
                                Tag="ContinueUntil"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                        <Button Content="Run Subscript"
                                Style="{StaticResource ToolButton}"
                                Tag="RunSubscript"
                                ToolTip="Click to configure, then Insert or drag into the script"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />

                        <TextBlock Text="Events"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,8,0,6" />
                        <Button Content="Event: Press Key"
                                Style="{StaticResource ToolButton}"
                                Tag="KeyPressEvent"
                                ToolTip="Click to configure, then Insert, drag into the script, or drop on a Continue Until event slot"
                                PreviewMouseLeftButtonDown="PaletteBlock_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="PaletteBlock_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="PaletteBlock_PreviewMouseLeftButtonUp" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Script sequence + library -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Library"
                                   Style="{StaticResource SectionTitle}" />

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="New"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding NewScriptCommand}" />
                            <Button Content="Save"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding SaveScriptCommand}" />
                            <Button Content="Open"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding OpenLibraryScriptCommand}" />
                            <Button Content="Delete"
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding DeleteLibraryScriptCommand}"
                                    Margin="0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding LibraryScripts}"
                                 SelectedItem="{Binding SelectedLibraryScript}"
                                 Height="110"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="1"
                                 DisplayMemberPath="Name"
                                 PreviewMouseLeftButtonDown="LibraryItem_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LibraryItem_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="LibraryItem_PreviewMouseLeftButtonUp" />
                    </DockPanel>
                </Border>

                <Border x:Name="ScriptPanel"
                        Grid.Row="2"
                        Style="{StaticResource PanelCard}"
                        Focusable="True"
                        PreviewKeyDown="ScriptPanel_PreviewKeyDown">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Script"
                                            Padding="10,4"
                                            Margin="0,0,6,0"
                                            Command="{Binding ShowScriptViewCommand}"
                                            FontWeight="{Binding ShowScriptEditor, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}" />
                                    <Button Content="Flow Graph"
                                            Padding="10,4"
                                            Command="{Binding ShowGraphViewCommand}"
                                            FontWeight="{Binding ShowFlowGraph, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}" />
                                </StackPanel>
                                <TextBox Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Width="220"
                                         HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding ShowScriptEditor, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Button Content="↑"
                                        Width="32"
                                        Margin="0,0,4,0"
                                        Command="{Binding MoveUpCommand}"
                                        ToolTip="Move up" />
                                <Button Content="↓"
                                        Width="32"
                                        Margin="0,0,4,0"
                                        Command="{Binding MoveDownCommand}"
                                        ToolTip="Move down" />
                                <Button Content="Remove"
                                        Margin="0,0,4,0"
                                        Padding="8,4"
                                        Command="{Binding RemoveSelectedCommand}" />
                                <Button Content="Clear"
                                        Padding="8,4"
                                        Command="{Binding ClearCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding ShowFlowGraph, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Button Content="Add If"
                                        Margin="0,0,4,0"
                                        Padding="8,4"
                                        Command="{Binding FlowGraphVm.AddIfNodeCommand}" />
                                <Button Content="Remove"
                                        Margin="0,0,4,0"
                                        Padding="8,4"
                                        Command="{Binding FlowGraphVm.DeleteSelectionCommand}" />
                                <Button Content="Clear"
                                        Padding="8,4"
                                        Command="{Binding ClearCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Linear script editor -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ShowScriptEditor, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                      AllowDrop="True"
                                      DragOver="ScriptRoot_DragOver"
                                      Drop="ScriptRoot_Drop"
                                      DragLeave="ScriptRoot_DragLeave">
                            <ItemsControl x:Name="ScriptList"
                                          ItemsSource="{Binding Blocks}"
                                          ItemTemplateSelector="{StaticResource BlockTemplateSelector}" />
                        </ScrollViewer>

                        <!-- Flow graph canvas -->
                        <Border Visibility="{Binding ShowFlowGraph, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                Background="#F8FAFC"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                AllowDrop="True"
                                DragOver="GraphCanvas_DragOver"
                                Drop="GraphCanvas_Drop"
                                ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          x:Name="GraphScroll">
                                <Canvas x:Name="GraphCanvas"
                                        Width="2400"
                                        Height="1600"
                                        Background="Transparent"
                                        MouseMove="GraphCanvas_MouseMove"
                                        MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                                        MouseLeftButtonDown="GraphCanvas_BackgroundDown">
                                    <!-- Edges -->
                                    <ItemsControl ItemsSource="{Binding FlowGraphVm.EdgeVisuals}"
                                                  IsHitTestVisible="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding X1}"
                                                      Y1="{Binding Y1}"
                                                      X2="{Binding X2}"
                                                      Y2="{Binding Y2}"
                                                      Stroke="#64748B"
                                                      StrokeThickness="2"
                                                      Cursor="Hand"
                                                      MouseLeftButtonDown="GraphEdge_MouseLeftButtonDown" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pending wire -->
                                    <Line X1="{Binding FlowGraphVm.PendingWireStart.X}"
                                          Y1="{Binding FlowGraphVm.PendingWireStart.Y}"
                                          X2="{Binding FlowGraphVm.PendingWireEnd.X}"
                                          Y2="{Binding FlowGraphVm.PendingWireEnd.Y}"
                                          Stroke="#2563EB"
                                          StrokeThickness="2"
                                          StrokeDashArray="4 2"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding FlowGraphVm.PendingWireVisibility}" />

                                    <!-- Nodes -->
                                    <ItemsControl ItemsSource="{Binding FlowGraphVm.Nodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="160"
                                                        MinHeight="72"
                                                        Background="White"
                                                        BorderBrush="#94A3B8"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8"
                                                        Cursor="SizeAll"
                                                        MouseLeftButtonDown="GraphNode_MouseLeftButtonDown"
                                                        MouseMove="GraphNode_MouseMove"
                                                        MouseLeftButtonUp="GraphNode_MouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="If">
                                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#0F172A" />
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   Foreground="#64748B"
                                                                   Margin="0,2,0,6"
                                                                   Visibility="{Binding Kind, Converter={x:Static conv:RunScriptKindVisibilityConverter.Instance}}" />

                                                        <!-- Ports -->
                                                        <StackPanel Grid.Row="2" Orientation="Vertical">
                                                            <!-- Condition input (If) -->
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,0,0,4"
                                                                        Visibility="{Binding Kind, Converter={x:Static conv:IfKindVisibilityConverter.Instance}}">
                                                                <Ellipse Width="10" Height="10"
                                                                         Fill="#F59E0B"
                                                                         Stroke="#B45309"
                                                                         Cursor="Cross"
                                                                         Tag="ConditionIn"
                                                                         MouseLeftButtonDown="GraphPort_MouseLeftButtonDown" />
                                                                <TextBlock Text="cond" FontSize="10" Margin="4,0,0,0" Foreground="#92400E" VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,2"
                                                                        Visibility="{Binding Kind, Converter={x:Static conv:RunScriptKindVisibilityConverter.Instance}}">
                                                                <TextBlock Text="next" FontSize="10" Margin="0,0,4,0" Foreground="#64748B" VerticalAlignment="Center" />
                                                                <Ellipse Width="10" Height="10"
                                                                         Fill="#22C55E"
                                                                         Stroke="#15803D"
                                                                         Cursor="Cross"
                                                                         Tag="Next"
                                                                         MouseLeftButtonDown="GraphPort_MouseLeftButtonDown" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,2"
                                                                        Visibility="{Binding Kind, Converter={x:Static conv:RunScriptKindVisibilityConverter.Instance}}">
                                                                <TextBlock Text="bool" FontSize="10" Margin="0,0,4,0" Foreground="#B45309" VerticalAlignment="Center" />
                                                                <Ellipse Width="10" Height="10"
                                                                         Fill="#F59E0B"
                                                                         Stroke="#B45309"
                                                                         Cursor="Cross"
                                                                         Tag="Condition"
                                                                         MouseLeftButtonDown="GraphPort_MouseLeftButtonDown" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,2"
                                                                        Visibility="{Binding Kind, Converter={x:Static conv:IfKindVisibilityConverter.Instance}}">
                                                                <TextBlock Text="then" FontSize="10" Margin="0,0,4,0" Foreground="#2563EB" VerticalAlignment="Center" />
                                                                <Ellipse Width="10" Height="10"
                                                                         Fill="#3B82F6"
                                                                         Stroke="#1D4ED8"
                                                                         Cursor="Cross"
                                                                         Tag="Then"
                                                                         MouseLeftButtonDown="GraphPort_MouseLeftButtonDown" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                        Visibility="{Binding Kind, Converter={x:Static conv:IfKindVisibilityConverter.Instance}}">
                                                                <TextBlock Text="else" FontSize="10" Margin="0,0,4,0" Foreground="#64748B" VerticalAlignment="Center" />
                                                                <Ellipse Width="10" Height="10"
                                                                         Fill="#94A3B8"
                                                                         Stroke="#475569"
                                                                         Cursor="Cross"
                                                                         Tag="Else"
                                                                         MouseLeftButtonDown="GraphPort_MouseLeftButtonDown" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Inspector -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Inspector"
                                   Style="{StaticResource SectionTitle}" />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   LineHeight="18"
                                   Visibility="{Binding SelectedBlock, Converter={x:Static conv:NullToVisibilityConverter.WhenNull}}">
                            Select a script block to edit, or a palette block to configure before inserting.
                        </TextBlock>

                        <!-- Palette draft banner -->
                        <StackPanel Margin="0,0,0,14"
                                    Visibility="{Binding IsPaletteDraft, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="New block"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#B45309"
                                       Margin="0,0,0,8" />
                            <Button Content="Insert into script"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InsertPaletteDraftCommand}"
                                    Margin="0,0,0,4" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="15"
                                       Text="Or drag from the palette into the script. Configured values are kept." />
                        </StackPanel>

                        <!-- Delay editor -->
                        <StackPanel Visibility="{Binding HasDelaySelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedDelay.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Milliseconds" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedDelay.Milliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />
                        </StackPanel>

                        <!-- Return Boolean editor -->
                        <StackPanel Visibility="{Binding HasReturnBooleanSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedReturnBoolean.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <CheckBox Content="Return true"
                                      IsChecked="{Binding SelectedReturnBoolean.Value}"
                                      Margin="0,0,0,10" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Last Return Boolean in a script sets its Boolean output. Wire the script node's bool port into an If condition on the Flow Graph." />
                        </StackPanel>

                        <!-- Find Image editor -->
                        <StackPanel Visibility="{Binding HasFindImageSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedFindImage.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Template image" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedFindImage.ImageFileName}"
                                       FontSize="11"
                                       Foreground="#374151"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding SelectedFindImage.HasImage, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="(none selected)"
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding SelectedFindImage.HasImage, Converter={x:Static conv:BoolToVisibilityConverter.Inverted}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Browse…"
                                        Padding="10,4"
                                        Margin="0,0,8,0"
                                        Command="{Binding BrowseFindImageCommand}" />
                                <Button Content="Clear"
                                        Padding="10,4"
                                        Command="{Binding ClearFindImageCommand}" />
                            </StackPanel>

                            <TextBlock Text="Confidence" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right"
                                           Width="42"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding SelectedFindImage.Confidence, StringFormat={}{0:P0}}" />
                                <Slider Minimum="0.05"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding SelectedFindImage.Confidence, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="15"
                                       Margin="0,0,0,10"
                                       Text="Lower confidence tolerates transparency and slight visual differences (ghost UI)." />

                            <TextBlock Text="Search scope" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ImageSearchScopeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedFindImage.Scope, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10"
                                      Padding="4" />

                            <StackPanel Visibility="{Binding SelectedFindImage.UsesWindow, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Window title contains" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedFindImage.WindowTitleContains, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"
                                         Padding="6,4" />
                                <TextBlock Text="Process name" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedFindImage.WindowProcessName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,4"
                                         Padding="6,4" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#6B7280"
                                           FontSize="11"
                                           LineHeight="15"
                                           Margin="0,0,0,10"
                                           Text="Resolved at run time. Example process: notepad (optional .exe)." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedFindImage.UsesRegion, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Region X / Y" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedFindImage.RegionX, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedFindImage.RegionY, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" />
                                </Grid>
                                <TextBlock Text="Region width / height" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedFindImage.RegionWidth, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedFindImage.RegionHeight, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" />
                                </Grid>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Sets this script's Boolean output (found = true). Use with Flow Graph If via the script's bool port." />
                        </StackPanel>

                        <!-- Flow graph node inspector -->
                        <StackPanel Visibility="{Binding FlowGraphVm.HasRunScriptSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="Graph: Run Script"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Script" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                              <ComboBox ItemsSource="{Binding LibraryScripts}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedGraphNodeScriptId, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10"
                                      Padding="4" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Drag from next to sequence another node. Drag from bool onto an If cond port to supply the condition." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding FlowGraphVm.HasIfSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="Graph: If"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Wire a script's bool output into cond. Then / else continue the graph when the condition is true or false." />
                        </StackPanel>

                        <!-- Mouse Move editor -->
                        <StackPanel Visibility="{Binding HasMouseMoveSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedMouseMove.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="X" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseMove.X, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4"
                                     IsEnabled="{Binding IsRecordingLocation, Converter={x:Static conv:InverseBoolConverter.Instance}}" />

                            <TextBlock Text="Y" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseMove.Y, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4"
                                     IsEnabled="{Binding IsRecordingLocation, Converter={x:Static conv:InverseBoolConverter.Instance}}" />

                            <TextBlock Text="Duration (ms)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseMove.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"
                                     Padding="6,4"
                                     IsEnabled="{Binding IsRecordingLocation, Converter={x:Static conv:InverseBoolConverter.Instance}}" />

                            <Button Content="Record Location"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RecordMouseMoveLocationCommand}"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding IsRecordingLocation, Converter={x:Static conv:BoolToVisibilityConverter.Inverted}}" />

                            <Button Content="Cancel Recording"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelRecordLocationCommand}"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding IsRecordingLocation, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Duration 0 jumps instantly. Any positive value lerps from the current cursor position to the target over that many milliseconds." />
                        </StackPanel>

                        <!-- Mouse Click editor -->
                        <StackPanel Visibility="{Binding HasMouseClickSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedMouseClick.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="X" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseClick.X, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />

                            <TextBlock Text="Y" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseClick.Y, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />

                            <TextBlock Text="Button" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding MouseButtonOptions}"
                                      SelectedItem="{Binding SelectedMouseClick.Button}"
                                      Margin="0,0,0,10"
                                      Padding="4" />

                            <TextBlock Text="Click count" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMouseClick.ClickCount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />
                        </StackPanel>

                        <!-- Key Press editor -->
                        <StackPanel Visibility="{Binding HasKeyPressSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedKeyPress.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Key" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding KeyPressKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />

                            <CheckBox Content="Ctrl"
                                      IsChecked="{Binding SelectedKeyPress.Ctrl}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Alt"
                                      IsChecked="{Binding SelectedKeyPress.Alt}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Shift"
                                      IsChecked="{Binding SelectedKeyPress.Shift}"
                                      Margin="0,0,0,10" />
                        </StackPanel>

                        <!-- Press Key event editor -->
                        <StackPanel Visibility="{Binding HasKeyPressEventSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedKeyPressEvent.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Name" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedKeyPressEvent.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />

                            <TextBlock Text="Key" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBox Text="{Binding KeyPressEventKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Padding="6,4" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="While the script runs, pressing this key flips the event flag. Use it with Continue Until." />
                        </StackPanel>

                        <!-- Continue Until editor -->
                        <StackPanel Visibility="{Binding HasContinueUntilSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedContinueUntil.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <StackPanel Visibility="{Binding IsPaletteDraft, Converter={x:Static conv:BoolToVisibilityConverter.Inverted}}">
                                <TextBlock Text="Until event" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableEvents}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedContinueUntilEventId, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,10"
                                          Padding="4" />
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="The amber slot accepts only events. Drag an event in or out of the slot; body blocks nest below." />
                        </StackPanel>

                        <!-- Run Subscript editor -->
                        <StackPanel Visibility="{Binding HasRunSubscriptSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedRunSubscript.DisplayName}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Subscript" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding LibraryScripts}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedRunSubscriptId, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10"
                                      Padding="4" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6B7280"
                                       FontSize="11"
                                       LineHeight="16"
                                       Text="Runs a saved library script inline. Save reusable sequences first, then call them from larger scripts." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
